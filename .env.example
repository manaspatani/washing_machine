# Supabase Configuration (Required for both Vercel & Render)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Render Backend URL (Optional — Set on Vercel if proxying API calls to Render backend)
# BACKEND_URL=https://washing-machine-backend.onrender.com
# NEXT_PUBLIC_BACKEND_URL=https://washing-machine-backend.onrender.com

# WhatsApp Integration (Optional)
# WHATSAPP_API_URL=https://api.your-whatsapp-provider.com
# WHATSAPP_API_KEY=your-whatsapp-api-key
# WHATSAPP_SENDER_NUMBER=+91XXXXXXXXXX
